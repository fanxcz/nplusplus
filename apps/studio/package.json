{
  "name": "npp-studio",
  "version": "1.1.0",
  "description": "The N++ desktop IDE with multi-file editing, project navigation, compiler diagnostics and an integrated terminal",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist": "electron-builder",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node --check renderer/npp-mode.js && node --check path-guard.cjs && node --test path-guard.test.cjs"
  },
  "dependencies": {
    "ace-builds": "^1.39.1"
  },
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.fanxcz.nppstudio",
    "productName": "NPP Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "path-guard.cjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "renderer/**/*",
      "node_modules/ace-builds/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "NPP-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "NPP-Studio-${version}-Linux-${arch}.${ext}",
      "maintainer": "N++ Project <noreply@github.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "NPP-Studio-${version}-macOS-${arch}.${ext}"
    }
  },
  "author": {
    "name": "fanxcz",
    "url": "https://github.com/fanxcz"
  },
  "homepage": "https://github.com/fanxcz/nplusplus/tree/main/apps/studio",
  "license": "MIT",
  "desktopName": "npp-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanxcz/nplusplus.git"
  }
}
