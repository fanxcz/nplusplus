// Process environment access. Missing variables read as empty strings.

fn env_get(name: string) -> string { return env(name) }

fn env_has(name: string) -> bool { return string.len(env(name)) > 0 }

// Parses a base-10 integer; returns `fallback` for empty or malformed values.
fn env_int(name: string, fallback: i64) -> i64 {
    let raw = string.trim(env(name))
    let n = string.len(raw)
    if n == 0 { return fallback }
    let mut i: i64 = 0
    let mut negative = false
    if string.byte_at(raw, 0) == 45 {
        negative = true
        i = 1
    }
    if i >= n { return fallback }
    let mut value: i64 = 0
    while i < n {
        let b = string.byte_at(raw, i)
        if b < 48 || b > 57 { return fallback }
        value = value * 10 +(b - 48)
        i = i + 1
    }
    if negative { return 0 - value }
    return value
}
