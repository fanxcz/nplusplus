// A minimal interactive N++ kernel shell.
// Build:  npp build hello.npp -o hello.elf --target kernel --backend native
// Run:    qemu-system-x86_64 -kernel hello.elf -display none -serial stdio
//
// Input is read from the PS/2 controller; output goes to VGA text and COM1.

fn key_char(code: i64) -> string {
    if code == 2 { return "1" }
    if code == 3 { return "2" }
    if code == 4 { return "3" }
    if code == 5 { return "4" }
    if code == 6 { return "5" }
    if code == 7 { return "6" }
    if code == 8 { return "7" }
    if code == 9 { return "8" }
    if code == 10 { return "9" }
    if code == 11 { return "0" }
    if code == 16 { return "q" }
    if code == 17 { return "w" }
    if code == 18 { return "e" }
    if code == 19 { return "r" }
    if code == 20 { return "t" }
    if code == 21 { return "y" }
    if code == 22 { return "u" }
    if code == 23 { return "i" }
    if code == 24 { return "o" }
    if code == 25 { return "p" }
    if code == 30 { return "a" }
    if code == 31 { return "s" }
    if code == 32 { return "d" }
    if code == 33 { return "f" }
    if code == 34 { return "g" }
    if code == 35 { return "h" }
    if code == 36 { return "j" }
    if code == 37 { return "k" }
    if code == 38 { return "l" }
    if code == 44 { return "z" }
    if code == 45 { return "x" }
    if code == 46 { return "c" }
    if code == 47 { return "v" }
    if code == 48 { return "b" }
    if code == 49 { return "n" }
    if code == 50 { return "m" }
    if code == 57 { return " " }
    return ""
}

fn main() {
    print("================================")
    print("  N++ KERNEL SHELL  v0.1")
    print("================================")
    print("type 'help' and press Enter; ESC halts")

    let mut line = ""
    let mut running = true

    while running {
        let code = read_key()
        if code <= 0 {
            continue
        }
        if code == 1 {
            running = false
        } else if code == 28 {
            print("> " + line)
            if line == "help" {
                print("commands: help ver clear echo")
            } else if line == "ver" {
                print("N++ kernel 1.0 / freestanding")
            } else if line == "clear" {
                print("")
            } else if line == "" {
                print("")
            } else {
                print(line)
            }
            line = ""
        } else if code == 14 {
            // Backspace: drop the last character of the line.
            let n = string.len(line)
            if n > 0 {
                line = string.slice(line, 0, n - 1)
            }
        } else {
            let ch = key_char(code)
            if string.len(ch) > 0 {
                line = line + ch
            }
        }
    }

    print("halted.")
}
