{
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "N++ program entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2})${3: -> i64} {",
      "    $0",
      "}"
    ],
    "description": "Declare a function"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:value})"
    ],
    "description": "Print a value"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Conditional block"
  },
  "If-else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2:// then}",
      "} else {",
      "    ${3:// else}",
      "    $0",
      "}"
    ],
    "description": "Conditional with else branch"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "While loop"
  },
  "For range": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:0}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "Iterate over a range"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:i64}",
      "}"
    ],
    "description": "Declare a structure"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} { ${2:VariantA}, ${3:VariantB} }"
    ],
    "description": "Declare an enumeration"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:Pattern} => {",
      "        $0",
      "    }",
      "    _ => {}",
      "}"
    ],
    "description": "Match expression with wildcard arm"
  },
  "Mutable variable": {
    "prefix": "letmut",
    "body": [
      "let mut ${1:name}: ${2:i64} = ${3:0}"
    ],
    "description": "Declare a mutable binding"
  },
  "Defer": {
    "prefix": "defer",
    "body": [
      "defer ${1:cleanup_call()}"
    ],
    "description": "Run cleanup at scope exit"
  },
  "Return": {
    "prefix": "ret",
    "body": [
      "return ${1:value}"
    ],
    "description": "Return a value"
  },
  "Break": {
    "prefix": "break",
    "body": [
      "break"
    ],
    "description": "Exit the innermost loop"
  },
  "Continue": {
    "prefix": "continue",
    "body": [
      "continue"
    ],
    "description": "Skip to the next loop iteration"
  },
  "Import stdlib": {
    "prefix": "import",
    "body": [
      "import std.${1:io}"
    ],
    "description": "Import a standard library module"
  },
  "Import file": {
    "prefix": "importfile",
    "body": [
      "import \"${1:module.npp}\""
    ],
    "description": "Import a sibling source file"
  },
  "Stdout helpers": {
    "prefix": "std",
    "body": [
      "import std.${1|io,fs,json,math,string,text,time,random,env,shell,collections,vec2,vec3|}"
    ],
    "description": "Import a standard library module by name"
  },
  "Comment block": {
    "prefix": "cblock",
    "body": [
      "// ${1:description}"
    ],
    "description": "Line comment"
  },
  "Test print": {
    "prefix": "testprint",
    "body": [
      "print(\"${1:name}: \" + str_i64(${2:value}))"
    ],
    "description": "Print a labeled integer for quick checks"
  }
}
