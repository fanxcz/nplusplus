{
  "name": "npp-language",
  "displayName": "N++ Language Support",
  "description": "N++ syntax highlighting, snippets, diagnostics, completion, signature help, hover, navigation, formatting and quick fixes.",
  "version": "1.2.2",
  "publisher": "fanxcz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:npp",
    "onCommand:npp.showServerOutput",
    "onCommand:npp.check",
    "onCommand:npp.build",
    "onCommand:npp.run",
    "onCommand:npp.fmt"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "npp",
        "aliases": [
          "N++",
          "npp"
        ],
        "extensions": [
          ".npp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "npp",
        "scopeName": "source.npp",
        "path": "./syntaxes/npp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "npp",
        "path": "./snippets/npp.json"
      }
    ],
    "configuration": {
      "title": "N++",
      "properties": {
        "npp.serverPath": {
          "type": "string",
          "default": "npp",
          "description": "Path to the N++ executable or launcher. The extension starts it with the lsp argument."
        },
        "npp.compilerPath": {
          "type": "string",
          "default": "npp",
          "description": "Path to the npp compiler executable used by the N++: Check/Build/Fmt/Run commands."
        }
      }
    },
    "commands": [
      {
        "command": "npp.showServerOutput",
        "title": "N++: Show Language Server Output"
      },
      {
        "command": "npp.check",
        "title": "N++: Check File"
      },
      {
        "command": "npp.build",
        "title": "N++: Build File"
      },
      {
        "command": "npp.run",
        "title": "N++: Run File"
      },
      {
        "command": "npp.fmt",
        "title": "N++: Format File"
      }
    ],
    "keybindings": [
      {
        "command": "npp.check",
        "key": "ctrl+alt+c",
        "when": "editorLangId == npp"
      },
      {
        "command": "npp.build",
        "key": "ctrl+alt+b",
        "when": "editorLangId == npp"
      },
      {
        "command": "npp.run",
        "key": "ctrl+alt+r",
        "when": "editorLangId == npp"
      },
      {
        "command": "npp.fmt",
        "key": "ctrl+alt+shift+f",
        "when": "editorLangId == npp"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fanxcz/nplusplus.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/fanxcz/nplusplus/issues"
  },
  "homepage": "https://github.com/fanxcz/nplusplus"
}
