if(NOT DEFINED NPP_BIN OR NOT DEFINED NPP_SOURCE_DIR OR NOT DEFINED TEST_BINARY_DIR)
  message(FATAL_ERROR "NPP_BIN, NPP_SOURCE_DIR, and TEST_BINARY_DIR are required")
endif()

set(PROGRAM_DIR "${NPP_SOURCE_DIR}/tests/slice_programs")
set(SCRATCH "${TEST_BINARY_DIR}/slice-llvm-smoke")
file(REMOVE_RECURSE "${SCRATCH}")
file(MAKE_DIRECTORY "${SCRATCH}")
if(WIN32)
  set(SUFFIX ".exe")
else()
  set(SUFFIX "")
endif()

set(EXE "${SCRATCH}/basic${SUFFIX}")
execute_process(
  COMMAND "${NPP_BIN}" build "${PROGRAM_DIR}/basic.npp" -o "${EXE}" --backend llvm
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "LLVM build of basic slice program failed:\n${out}\n${err}")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE rc OUTPUT_VARIABLE got ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "basic slice program failed with ${rc}: ${err}")
endif()
string(REPLACE "\r\n" "\n" got "${got}")
string(REGEX REPLACE "\n+$" "" got "${got}")
set(expected "4\n2\n10\n20\n30\n1\n20\n3")
if(NOT got STREQUAL expected)
  message(FATAL_ERROR "slice output mismatch:\n--- got ---\n${got}\n--- expected ---\n${expected}")
endif()

# The default auto selector must fall back to LLVM for slice types.
set(AUTO_EXE "${SCRATCH}/basic-auto${SUFFIX}")
execute_process(
  COMMAND "${NPP_BIN}" build "${PROGRAM_DIR}/basic.npp" -o "${AUTO_EXE}" --backend auto
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "automatic backend selection failed for slice program:\n${out}\n${err}")
endif()
execute_process(COMMAND "${AUTO_EXE}" RESULT_VARIABLE rc OUTPUT_VARIABLE auto_got ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "auto-selected slice executable failed with ${rc}: ${err}")
endif()
string(REPLACE "\r\n" "\n" auto_got "${auto_got}")
string(REGEX REPLACE "\n+$" "" auto_got "${auto_got}")
if(NOT auto_got STREQUAL expected)
  message(FATAL_ERROR "auto backend did not produce expected slice output: ${auto_got}")
endif()

if(NOT DEFINED NPP_NATIVE_BACKEND_SUPPORTED)
  set(NPP_NATIVE_BACKEND_SUPPORTED ON)
endif()
if(NPP_NATIVE_BACKEND_SUPPORTED)
# The native backend supports read-only slices and must produce identical output.
set(NATIVE_EXE "${SCRATCH}/basic-native${SUFFIX}")
execute_process(
  COMMAND "${NPP_BIN}" build "${PROGRAM_DIR}/basic.npp" -o "${NATIVE_EXE}" --backend native
  RESULT_VARIABLE native_rc OUTPUT_VARIABLE native_out ERROR_VARIABLE native_err)
if(NOT native_rc EQUAL 0)
  message(FATAL_ERROR "native backend rejected the read-only slice program:\n${native_out}\n${native_err}")
endif()
execute_process(COMMAND "${NATIVE_EXE}" RESULT_VARIABLE native_rc OUTPUT_VARIABLE native_got ERROR_VARIABLE native_err)
if(NOT native_rc EQUAL 0)
  message(FATAL_ERROR "native slice executable failed with ${native_rc}: ${native_err}")
endif()
string(REPLACE "\r\n" "\n" native_got "${native_got}")
string(REGEX REPLACE "\n+$" "" native_got "${native_got}")
if(NOT native_got STREQUAL expected)
  message(FATAL_ERROR "native slice output mismatch:\n--- got ---\n${native_got}\n--- expected ---\n${expected}")
endif()
endif()

foreach(case index_oob range_oob)
  set(EXE "${SCRATCH}/${case}${SUFFIX}")
  execute_process(
    COMMAND "${NPP_BIN}" build "${PROGRAM_DIR}/${case}.npp" -o "${EXE}" --backend llvm
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "LLVM build of ${case} failed:\n${out}\n${err}")
  endif()
  execute_process(COMMAND "${EXE}" RESULT_VARIABLE rc OUTPUT_VARIABLE got ERROR_VARIABLE err)
  if(rc EQUAL 0)
    message(FATAL_ERROR "${case} should fail its runtime slice bounds check")
  endif()
  if(case STREQUAL "index_oob" AND NOT err MATCHES "out of bounds")
    message(FATAL_ERROR "index_oob had unexpected diagnostic: ${err}")
  endif()
  if(case STREQUAL "range_oob" AND NOT err MATCHES "invalid slice range")
    message(FATAL_ERROR "range_oob had unexpected diagnostic: ${err}")
  endif()
endforeach()

message(STATUS "N++ LLVM slice lowering: PASS")
