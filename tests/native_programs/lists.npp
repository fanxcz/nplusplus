fn main() {
    let h = ilist_new()
    ilist_push(h, 10)
    ilist_push(h, 20)
    ilist_push(h, 30)
    print(ilist_len(h))
    print(ilist_get(h, 1))
    ilist_set(h, 1, 99)
    print(ilist_get(h, 1))
    let mut out: i64 = 0
    print(ilist_try_get(h, 2,&out))
    print(out)
    print(ilist_try_pop(h,&out))
    print(out)
    print(ilist_len(h))
    ilist_insert(h, 0, 7)
    print(ilist_get(h, 0))
    print(ilist_remove(h, 0,&out))
    print(out)
    print(ilist_len(h))
    print(ilist_reserve(h, 100))
    print(ilist_clear(h))
    print(ilist_len(h))
    print(ilist_free(h))
    print(ilist_get(h, 0))

    let s = slist_new()
    slist_push(s, "alpha")
    slist_push(s, "beta")
    slist_push(s, "gamma")
    print(slist_len(s))
    print(slist_get(s, 0))
    print(slist_get(s, 2))
    let mut w: string = ""
    print(slist_try_get(s, 1,&w))
    print(w)
    print(slist_try_pop(s,&w))
    print(w)
    print(slist_insert(s, 1, "mid"))
    print(slist_get(s, 1))
    print(slist_remove(s, 0,&w))
    print(w)
    print(slist_set_checked(s, 0, "new"))
    print(slist_get(s, 0))
    print(slist_free(s))
}
