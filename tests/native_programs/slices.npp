fn pass(values: []i64) -> []i64 {
    return values;
}

fn sum(values: []i64) -> i64 {
    let mut total: i64 = 0;
    for i in 0..len(values) {
        total += values[i];
    }
    return total;
}

fn main() {
    let values = [5, 10, 20, 30];
    let middle = values[1..3];
    let alias = pass(middle);
    print(len(values));
    print(len(alias));
    print(alias[0]);
    print(alias[1]);
    print(sum(alias));

    let nested = values[1..4][1..2];
    print(len(nested));
    print(nested[0]);

    let empty = values[2..2];
    print(len(empty));

    let copy = middle;
    print(len(copy));
    print(copy[0]);

    let mut acc: i64 = 0;
    for i in 0..len(middle) {
        acc += middle[i] * 2;
    }
    print(acc);
}
